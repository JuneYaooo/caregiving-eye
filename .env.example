# ===== 米家账号（敏感）=====
MI_USER=
MI_PASS=

# ===== 摄像头 =====
CAMERA_IP=
CAMERA_DID=
CAMERA_MODEL=
CAMERA_REGION=cn

# ===== 局域网扫描网段（逗号分隔）=====
SUBNETS=

# ===== 本地服务 =====
GO2RTC_API=http://127.0.0.1:1984
RTSP_URL=rtsp://127.0.0.1:8554/living
ONVIF_BASE=http://127.0.0.1:8891

# ===== 可选事件转发（兼容转发服务地址，留空则只记录本地事件）=====
ALERT_WEBHOOK=

# ===== 执事 =====
BUTLER_NAME=米执事
OWNER_TITLE=老爷
# 值班日程: 时段:模式 (分号分隔)
MODE_SCHEDULE=23:00-07:00:night
ABSENCE_MIN=480
ZONE_DWELL_MIN=20
MODELS_DIR=models
EVENTS_DIR=events

# ===== 可选能力（缺模型 / 依赖时自动跳过）=====
# 跟踪器: iou (内置) | bytetrack (需 pip install "supervision>=0.20,<0.30")
TRACKER=iou
# 火焰烟雾模型 (YOLOv8 导出的 ONNX)，类别顺序与 FIRE_CLASSES 一致
FIRE_MODEL=models/fire-smoke-yolov8n.onnx
FIRE_CLASSES=smoke,fire
FIRE_SCORE=0.45
# 声音事件 (YAMNet ONNX + 类名表；需安装 ffmpeg)，留空 AUDIO_SOURCE 则用 RTSP_URL
AUDIO_MODEL=models/yamnet.onnx
AUDIO_CLASS_MAP=models/yamnet_class_map.csv
AUDIO_SOURCE=
# 视频存证：事件前 / 后各保存多少秒
CLIP_PRE_SEC=10
CLIP_POST_SEC=15
# 录像缩放后的宽度（像素），越大越清楚，也越占内存
CLIP_WIDTH=640
# 突发不适：休息区外躺倒秒数、倒卧后无动作秒数、白天长时间无动作分钟数
ILL_LYING_SEC=60
ILL_STILL_SEC=120
STILL_ALERT_MIN=90
# 儿童危险：家里有孩子时设为 1
HAS_CHILD=0
# 站立时身长 / 画面高 落在此区间视为儿童（机位标定后填，留空只用身体比例）
CHILD_HEIGHT_BAND=
CHILD_LEG_RATIO=0.46
# 成人在孩子多近范围内算“有人陪同”（画面宽度比例）
ADULT_NEAR=0.25
CHILD_ALONE_MIN=10
# 宠物模式下多少小时没看到宠物就提醒，0 关闭
PET_UNSEEN_HOURS=0
# 骨架时序跌倒分类（ST-GCN ONNX，训练方法见 docs/algorithms.md；文件不存在时只用姿态规则）
FALL_GCN_MODEL=models/fall_stgcn.onnx
# both：规则和模型都判跌倒才急报，只有一方判断时发“疑似跌倒”；either：规则单独判断也急报
FALL_FUSION=both
# 模型确认规则用的概率阈值；模型单独报“疑似跌倒”要求的更高阈值
FALL_GCN_TH=0.6
FALL_GCN_STRONG=0.9
# 家具化过滤：人形目标位移超过画面宽度的这个比例才算“动过”，没动过的不参与跌倒 / 入侵 / 不适判断
MOBILE_TH=0.04
# 连续多少秒没看到人才通报“人都出门了”（防遮挡、漏检误报）
DEPART_CONFIRM_SEC=60
# 作息偏离：0 关闭；一天从几点算起；攒够几天开始对比；对比最近几天
ROUTINE_ENABLE=1
ROUTINE_DAY_START=4
ROUTINE_MIN_DAYS=7
ROUTINE_HISTORY_DAYS=28
# 比平时开始走动的时间晚多少分钟提醒；活动量低于平时同时段的多少比例提醒
ROUTINE_LATE_MIN=90
ROUTINE_LOW_RATIO=0.35

# ===== 大脑：调度与长期运行（详见 docs/brain.md）=====
# 三个警觉等级的检测频率：闲时间隔秒数 / 有动静帧率 / 有事件帧率
DETECT_IDLE_SEC=1.5
# 有人时用姿态模型找人，猫狗检测每隔多少秒跑一次（宠物模式下每次都跑）
PET_DETECT_SEC=3
DETECT_FPS=3
DETECT_ALERT_FPS=5
# 安静多少秒后降低警觉等级
CALM_DOWN_SEC=30
# 每个视觉模型的推理线程数；一轮任务耗时预算（秒），超出时统计类任务让路
ORT_THREADS=2
TICK_BUDGET=0.6
# 急报无人确认时的催办间隔（秒）与最多次数
REMIND_SEC=180
MAX_REMINDS=5
# 断流多久提醒（秒）
STREAM_DOWN_SEC=120
# 快照与录像保留天数、总量上限（GB）
RETAIN_DAYS=7
MAX_EVENTS_GB=5
# 每日日报时间
REPORT_AT=21:30
# 本机指令入口端口（只监听 127.0.0.1），机器人把“没事 / 收到 / 是我”等回复转到这里；0 关闭
COMMAND_PORT=8766
# 指令口令（请求头 X-Butler-Token）；留空则首次启动自动生成到 .command_token
COMMAND_TOKEN=
# 守护模式（main.py serve）：心跳超过多少秒没更新视为卡死并重启
HEARTBEAT_SEC=180
